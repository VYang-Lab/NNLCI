  - family-names: Huang
    given-names: Haoxiang
  - family-names: Yang
    given-names: Vigor
repository-code: "https://github.com/jinboxiao98/NNLCI"
license: MIT
keywords:
  - neural networks
  - multi-fidelity learning
  - computational fluid dynamics
  - conservation laws
  - shock waves
  - strong gradients
